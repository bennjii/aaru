# Terraform/OpenTofu working directories. Provider binaries are ~60 MiB each
# and are reinstalled by `tofu init`; the .terraform.lock.hcl beside them is
# the part worth committing.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Terragrunt copies each unit here before running it.
.terragrunt-cache/
# Modules are not roots; only units carry a lock file.
infrastructure/terraform/modules/*/.terraform.lock.hcl
# Infracost plans and estimates from `just terraform::cost`.
infrastructure/terraform/.cost/
